logs/
*.log

# ML Data (too large)
ml/data/raw/*
ml/data/processed/*
ml/data/feedback/*

# Git
.git/
.gitignore

# Docker
Dockerfile
.dockerignore

# Documentation
*.md
docs/

# Secrets - NEVER include
serviceAccountKey.json
*.pem
*.key
secrets/
