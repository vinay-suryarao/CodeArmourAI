# Backend Docker Ignore
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
.env
.env.*
*.env

# IDE
.idea/
.vscode/
*.swp
*.swo

# Tests (not needed in production image)
tests/
.pytest_cache/
.coverage
htmlcov/

