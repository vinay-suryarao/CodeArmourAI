# Backend Environment Variables (FastAPI)
# Copy this file to .env and fill in the values
# WARNING: NEVER commit this file to git - contains secrets!

# ===================
# App Settings
# ===================
APP_NAME=CodeArmour AI
APP_ENV=development
DEBUG=true
API_VERSION=v1

# ===================
# Server Configuration
# ===================
HOST=0.0.0.0
PORT=8000

# ===================
# CORS Settings
# ===================
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ===================
# Firebase Admin SDK Configuration (PRIVATE - Keep Secret!)
# Get from: Firebase Console -> Project Settings -> Service Accounts -> Generate new private key
# ===================
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY_ID=your-private-key-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=your-client-id
FIREBASE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token

# ===================
# ML Model Settings
# ===================
MODEL_PATH=./ml/models/codebert-vulnerability
MODEL_NAME=microsoft/codebert-base
MAX_TOKEN_LENGTH=512
CONFIDENCE_THRESHOLD=0.7
BATCH_SIZE=8

# ===================
# MLflow Settings (Experiment Tracking)
# ===================
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=codearmour-vulnerability-detection

# ===================
# Retraining Pipeline Settings
# ===================
FEEDBACK_THRESHOLD=100
AUTO_RETRAIN=true
RETRAIN_SCHEDULE=0 0 * * 0

# ===================
# Hugging Face (Model Hosting)
# ===================
HF_TOKEN=your-huggingface-token
HF_SPACE_NAME=your-username/codearmour-ai
HF_MODEL_REPO=your-username/codearmour-model

# ===================
# Logging
# ===================
LOG_LEVEL=INFO
LOG_FORMAT=json
